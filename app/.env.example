# Copiez ce fichier vers .env et remplissez les valeurs (jamais commitées).
# URL du projet Supabase (Settings > API)
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé anonyme (publique) du projet Supabase
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Secret partagé avec l'Edge Function widget-actions (widget iOS).
# Générer : openssl rand -hex 24 — même valeur dans `supabase secrets set WIDGET_SECRET=…`
# et dans les variables d'environnement EAS (jamais dans eas.json).
EXPO_PUBLIC_WIDGET_SECRET=

# Access token personnel Supabase (sbp_…) : MCP officiel headless (.mcp.json)
#   → https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Service role (MCP supabase-db, data-only — jamais dans le client Expo !)
SUPABASE_SERVICE_ROLE_KEY=
