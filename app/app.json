{
  "expo": {
    "name": "UBUNTU",
    "slug": "ubuntu",
    "version": "1.5.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ubuntu",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.gregdeshusses.ubuntu",
      "appleTeamId": "H64BBH4HUR",
      "supportsTablet": false,
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.gregdeshusses.ubuntu"
        ]
      }
    },
    "android": {
      "package": "com.gregdeshusses.ubuntu",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "UBUNTU place votre avatar sur le plan selon que vous êtes à l'appartement ou non.",
          "locationAlwaysAndWhenInUsePermission": "UBUNTU vous propose de laisser Ubuntu seul quand vous rentrez à l'appartement, même si l'app est fermée.",
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E8DFC8",
          "image": "./assets/images/splash-ubuntu.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#171928"
          }
        }
      ],
      "expo-audio",
      "expo-video",
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-asset",
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4d8f4894-c6d5-434c-b3e4-4d9607e6b24c"
      }
    },
    "owner": "gregoire.deshusses",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/4d8f4894-c6d5-434c-b3e4-4d9607e6b24c"
    }
  }
}
