# Copier vers .env et remplir. NE JAMAIS COMMITER LE FICHIER .env.

# Flux RTSP de la caméra Tapo (compte LOCAL créé dans l'app Tapo, pas le compte cloud).
# stream2 = basse qualité, suffisant pour l'audio et plus léger.
CAMERA_RTSP_URL=rtsp://USER:PASS@192.168.1.50:554/stream2

# Projet Supabase.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Service role key (Dashboard → Settings → API). Reste UNIQUEMENT sur ce PC.
SUPABASE_SERVICE_KEY=eyJ...

# UUID du chien (table dogs — créé via l'app ou le SQL editor Supabase).
DOG_ID=00000000-0000-0000-0000-000000000000

# Seuil de confiance de détection (défaut 0.3). À calibrer avec --dry-run.
CONFIDENCE_THRESHOLD=0.3

# Nom de la machine, informatif.
DEVICE_NAME=asus-agent
